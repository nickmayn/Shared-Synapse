CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=../.chroma
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
KNOWLEDGE_REPO_PATH=..
LOG_LEVEL=INFO
DEV_MODE=true

# Auth
JWT_SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_DEFAULT_PASSWORD=changeme

# CORS (comma-separated origins for the FastAPI app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional GitHub token for the public repo importer. Strongly recommended to avoid
# anonymous API rate limits when searching or inspecting repositories.
# GITHUB_TOKEN=ghp_your_token_here

# Override paths (optional)
# USERS_DB_PATH=../.synapse_users.db
# SYNAPSES_DIR=../synapses
