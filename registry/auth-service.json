{
  "id": "auth-service",
  "description": "Interact with the authentication service: validate tokens, create users, manage sessions",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["validate_token", "create_user", "revoke_session", "list_sessions"]
      },
      "token": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      }
    },
    "required": ["action"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {"type": "string"},
      "data": {"type": "object"}
    }
  },
  "metadata": {
    "tags": ["auth", "security", "backend"],
    "owner": "platform-team",
    "version": "1.0"
  }
}
